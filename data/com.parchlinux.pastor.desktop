[Desktop Entry]
Name=Parch Store
Name[fa]=فروشگاه پارچ
GenericName=Software Center
GenericName[fa]=مرکز نرم‌افزار
Comment=Discover and install software on ParchLinux
Comment[fa]=کشف و نصب نرم‌افزار در پارچ‌لینوکس
Exec=pastor %u
Icon=com.parchlinux.pastor
Terminal=false
Type=Application
Categories=System;PackageManager;Settings;
MimeType=x-scheme-handler/pastor;x-scheme-handler/appstream;
StartupNotify=true
StartupWMClass=com.parchlinux.pastor
Keywords=pastor;store;software;package;packages;app;application;apps;install;update;updates;upgrade;download;manager;center;repo;repository;parch;pacman;flatpak;aur;marketplace;programs;discover;
Keywords[fa]=فروشگاه;نرم‌افزار;بسته;برنامه;نصب;به‌روزرسانی;آپدیت;دانلود;مدیر;مخزن;پارچ;پک‌من;فلت‌پک;برنامه‌ها;
Actions=Updates;CheckUpdates;

[Desktop Action Updates]
Name=Updates
Name[fa]=به‌روزرسانی‌ها
Exec=pastor --updates

[Desktop Action CheckUpdates]
Name=Check for Updates
Name[fa]=بررسی به‌روزرسانی‌ها
Exec=pastor --check-updates
