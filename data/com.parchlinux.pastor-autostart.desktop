[Desktop Entry]
Name=Parch Store (Tray)
GenericName=Software Center Indicator
Comment=Background update checker for Parch Store
Exec=pastor --hidden
Icon=com.parchlinux.pastor
Terminal=false
Type=Application
Categories=System;PackageManager;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
X-KDE-autostart-phase=2
X-MATE-Autostart-enabled=true
X-XFCE-Autostart-enabled=true
